# Storyblok Content Delivery API token (Space Settings -> Access Tokens).
# A "preview" token can read draft content; a "public" token only sees published.
NUXT_STORYBLOK_ACCESS_TOKEN=

# Space region: eu (default), us, ap, ca or cn.
NUXT_STORYBLOK_REGION=eu

# Public site origin, used for canonical and hreflang links. Set it to the
# address of the environment being built (e.g. the test site).
NUXT_PUBLIC_SITE_URL=https://surgeriicom.webhosting.be
