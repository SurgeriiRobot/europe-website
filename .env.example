# Storyblok Content Delivery API token (Space Settings -> Access Tokens).
# This one reaches the browser, so it MUST be a "public" token. A "preview"
# token here lets anyone reading the page source fetch unpublished content.
NUXT_STORYBLOK_ACCESS_TOKEN=

# Storyblok "preview" token, read by the server only. It serves draft content
# to the Visual Editor via /api/preview-story, and builds the test site.
# Never give this one a NUXT_PUBLIC_ prefix.
NUXT_STORYBLOK_PREVIEW_TOKEN=

# Space region: eu (default), us, ap, ca or cn.
NUXT_STORYBLOK_REGION=eu

# Public site origin, used for canonical and hreflang links. Set it to the
# address of the environment being built (e.g. the test site).
NUXT_PUBLIC_SITE_URL=https://surgeriicom.webhosting.be
